generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CollectionStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ClientCollectionStatus {
  NOT_STARTED
  IN_PROGRESS
  MISSING
  COMPLETE
}

enum RequiredDocumentStatus {
  MISSING
  RECEIVED
  NOT_APPLICABLE
}

enum ReminderChannel {
  WHATSAPP
  EMAIL
  PHONE
  MANUAL
}

enum DocumentQualityStatus {
  UNREVIEWED
  VALID
  WRONG_DOCUMENT
  UNREADABLE
  DUPLICATE
  MISSING_PAGE
  NOT_TVA
}

enum OperationalActorType {
  USER
  CLIENT
  SYSTEM
}

enum UserRole {
  OWNER
  MANAGER
  ASSISTANT
  READ_ONLY
  ADMIN
}

enum FirmStatus {
  TRIAL
  ACTIVE
  OVERDUE
  SUSPENDED
  CANCELLED_BUT_ACTIVE
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  TRIAL
  ACTIVE
  PAST_DUE
  OVERDUE
  UNPAID
  SUSPENDED
  CANCELLED_BUT_ACTIVE
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  UNPAID
  PAYMENT_PROOF_SUBMITTED
  PAID
  OVERDUE
  CANCELLED
}

enum BillingPaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  ONLINE_CARD
  OTHER
}

enum PaymentProofStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum DocumentSecurityScanStatus {
  PENDING
  CLEAN
  SUSPICIOUS
  INFECTED
  FAILED
  QUARANTINED
}

enum ScannerProvider {
  NONE
  CLAMAV
  EXTERNAL
  MANUAL
}

enum ErrorSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum ReleaseChecklistStatus {
  TODO
  PASSED
  FAILED
  BLOCKED
}

enum WorkflowType {
  TVA_MONTHLY
  TVA_QUARTERLY
  CNSS_MONTHLY
  PAYROLL
  ANNUAL_CLOSING
  BANK_DOCUMENTS
  LEGAL_DOCUMENTS
  CLIENT_ONBOARDING
  EMPLOYEE_DOCUMENTS
  SUPPLIER_DOCUMENTS
  CUSTOM
}

enum TvaPreparationStatus {
  COLLECTING
  READY_FOR_REVIEW
  UNDER_REVIEW
  READY_FOR_PREPARATION
  PREPARING
  MANAGER_REVIEW
  READY_TO_DECLARE
  DECLARED
  ARCHIVED
  BLOCKED
}

enum TvaFilingStatus {
  DRAFT
  READY_TO_FILE
  FILED
  PAYMENT_PENDING
  PAID
  ARCHIVED
  BLOCKED
  AMENDED
}

enum TvaSubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  REJECTED
  NEEDS_CORRECTION
}

enum TvaPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  LATE
  FAILED
}

enum TvaPaymentMethod {
  BANK_TRANSFER
  ONLINE_PORTAL
  CASH
  OTHER
}

enum FiscalReceiptType {
  DECLARATION_RECEIPT
  PAYMENT_RECEIPT
  PORTAL_SCREENSHOT
  TAX_AUTHORITY_REFERENCE
  OTHER
}

enum FiscalAuditCaseType {
  TAX_CONTROL
  INTERNAL_REVIEW
  CLIENT_DISPUTE
  MISSING_PROOF
  OTHER
}

enum FiscalAuditCaseStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  WAITING_AUTHORITY
  RESOLVED
  CLOSED
}

enum FiscalSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaxAuthorityNoticeType {
  REQUEST_INFO
  PAYMENT_NOTICE
  PENALTY_NOTICE
  CORRECTION_REQUEST
  CONTROL_NOTICE
  OTHER
}

enum TaxAuthorityNoticeStatus {
  NEW
  REVIEWED
  RESPONSE_REQUIRED
  RESPONDED
  CLOSED
}

enum FiscalEvidenceRequestStatus {
  TODO
  IN_PROGRESS
  WAITING_CLIENT
  READY
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum AuditResponseStatus {
  DRAFT
  REVIEW_REQUIRED
  APPROVED
  SENT
}

enum FiscalFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum ClientTvaFrequency {
  MONTHLY
  QUARTERLY
  EXEMPT
  CUSTOM
}

enum TvaReadinessStatus {
  NOT_READY
  READY_WITH_WARNINGS
  READY
  BLOCKED
}

enum TvaAmountEntryType {
  PURCHASE
  SALE
  EXPENSE
  CREDIT_NOTE
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  passwordHash          String?
  passwordChangedAt     DateTime?
  role                  UserRole               @default(OWNER)
  isActive              Boolean                @default(true)
  disabledAt            DateTime?
  disabledReason        String?                @db.Text
  firmId                String?
  firm                  Firm?                  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  passwordResetTokens   PasswordResetToken[]
  notificationState     UserNotificationState?
  releaseChecklistItems ReleaseChecklistItem[]

  @@index([firmId])
  @@index([role])
  @@index([isActive])
}

model UserNotificationState {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firmId     String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([firmId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Firm {
  id                       String                 @id @default(cuid())
  name                     String
  city                     String?
  phone                    String?
  email                    String?
  status                   FirmStatus             @default(TRIAL)
  plan                     String                 @default("STARTER")
  trialStartDate           DateTime?
  trialEndDate             DateTime?
  suspendedAt              DateTime?
  suspendedReason          String?                @db.Text
  cancelledAt              DateTime?
  logoUrl                  String?
  defaultRequiredDocuments Json?
  reminderTemplate         String?                @db.Text
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  users                    User[]
  invites                  UserInvite[]
  clients                  Client[]
  collectionPeriods        CollectionPeriod[]
  clientCollections        ClientCollection[]
  requiredDocuments        RequiredDocument[]
  uploadedDocuments        UploadedDocument[]
  documentSecurityScans    DocumentSecurityScan[]
  reminderLogs             ReminderLog[]
  leads                    Lead[]
  fiscalConfig             FiscalConfig?
  tvaRates                 TvaRate[]
  fiscalRegimes            FiscalRegime[]
  clientFiscalProfiles     ClientFiscalProfile[]
  tvaAmountEntries         TvaAmountEntry[]
  tvaReadinessChecks       TvaReadinessCheck[]
  errorLogs                ErrorLog[]
  subscriptions            FirmSubscription[]
  billingInvoices          BillingInvoice[]
  paymentProofs            PaymentProof[]
  billingReceipts          BillingReceipt[]
}

model UserInvite {
  id              String    @id @default(cuid())
  firmId          String
  firm            Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  email           String
  name            String?
  role            UserRole
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())

  @@index([firmId])
  @@index([email])
  @@index([expiresAt])
}

model Client {
  id                String               @id @default(cuid())
  firmId            String
  firm              Firm                 @relation(fields: [firmId], references: [id], onDelete: Cascade)
  companyName       String
  contactName       String?
  email             String?
  phone             String?
  ice               String?
  taxId             String?
  city              String?
  notes             String?              @db.Text
  deletedAt         DateTime?
  deletedByUserId   String?
  deleteReason      String?              @db.Text
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  clientCollections ClientCollection[]
  fiscalProfile     ClientFiscalProfile?
  tvaAmountEntries  TvaAmountEntry[]

  @@index([firmId])
  @@index([firmId, deletedAt])
}

model FiscalConfig {
  id                    String          @id @default(cuid())
  firmId                String          @unique
  firm                  Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  countryCode           String          @default("MA")
  defaultCurrency       String          @default("MAD")
  defaultTvaFrequency   FiscalFrequency @default(MONTHLY)
  defaultDeclarationDay Int             @default(20)
  defaultPaymentDay     Int             @default(25)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([firmId])
}

model TvaRate {
  id        String   @id @default(cuid())
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  label     String
  rate      Decimal  @db.Decimal(5, 2)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmId])
  @@index([firmId, isActive])
}

model FiscalRegime {
  id          String          @id @default(cuid())
  firmId      String
  firm        Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  name        String
  description String?         @db.Text
  frequency   FiscalFrequency @default(MONTHLY)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([firmId])
  @@index([firmId, isActive])
}

model ClientFiscalProfile {
  id                     String             @id @default(cuid())
  firmId                 String
  firm                   Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  clientId               String             @unique
  client                 Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ice                    String?
  identifiantFiscal      String?
  registreCommerce       String?
  cnssNumber             String?
  tvaRegimeId            String?
  tvaFrequency           ClientTvaFrequency @default(MONTHLY)
  declarationDayOverride Int?
  paymentDayOverride     Int?
  fiscalRiskLevel        FiscalSeverity     @default(LOW)
  assignedAccountantId   String?
  notes                  String?            @db.Text
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([firmId])
  @@index([firmId, fiscalRiskLevel])
  @@index([assignedAccountantId])
}

model CollectionPeriod {
  id                String             @id @default(cuid())
  firmId            String
  firm              Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  name              String
  workflowType      WorkflowType       @default(TVA_MONTHLY)
  month             Int
  year              Int
  status            CollectionStatus   @default(ACTIVE)
  deletedAt         DateTime?
  deletedByUserId   String?
  deleteReason      String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  clientCollections ClientCollection[]

  @@index([firmId])
  @@index([firmId, workflowType])
  @@index([firmId, deletedAt])
}

model ClientCollection {
  id                         String                 @id @default(cuid())
  firmId                     String
  firm                       Firm                   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  clientId                   String
  client                     Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  collectionPeriodId         String
  collectionPeriod           CollectionPeriod       @relation(fields: [collectionPeriodId], references: [id], onDelete: Cascade)
  uploadToken                String                 @unique
  uploadTokenExpiresAt       DateTime?
  uploadTokenDisabledAt      DateTime?
  status                     ClientCollectionStatus @default(NOT_STARTED)
  tvaPreparationStatus       TvaPreparationStatus   @default(COLLECTING)
  isLocked                   Boolean                @default(false)
  lockedAt                   DateTime?
  lockedByUserId             String?
  lockReason                 String?                @db.Text
  accountantNotes            String?                @db.Text
  completionConfirmedAt      DateTime?
  completionConfirmationText String?                @db.Text
  deletedAt                  DateTime?
  deletedByUserId            String?
  deleteReason               String?                @db.Text
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  requiredDocuments          RequiredDocument[]
  uploadedDocuments          UploadedDocument[]
  reminderLogs               ReminderLog[]
  tvaAmountEntries           TvaAmountEntry[]
  tvaReadinessChecks         TvaReadinessCheck[]

  @@unique([clientId, collectionPeriodId])
  @@index([firmId])
  @@index([firmId, tvaPreparationStatus])
  @@index([firmId, isLocked])
  @@index([firmId, deletedAt])
  @@index([uploadTokenExpiresAt])
  @@index([uploadTokenDisabledAt])
}

model RequiredDocument {
  id                 String                 @id @default(cuid())
  firmId             String
  firm               Firm                   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  clientCollectionId String
  clientCollection   ClientCollection       @relation(fields: [clientCollectionId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  isRequired         Boolean                @default(true)
  status             RequiredDocumentStatus @default(MISSING)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  uploadedDocuments  UploadedDocument[]

  @@index([firmId])
  @@index([clientCollectionId])
}

model UploadedDocument {
  id                          String                @id @default(cuid())
  firmId                      String
  firm                        Firm                  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  clientCollectionId          String
  clientCollection            ClientCollection      @relation(fields: [clientCollectionId], references: [id], onDelete: Cascade)
  requiredDocumentId          String?
  requiredDocument            RequiredDocument?     @relation(fields: [requiredDocumentId], references: [id], onDelete: SetNull)
  originalFileName            String
  storageKey                  String
  mimeType                    String
  size                        Int
  qualityStatus               DocumentQualityStatus @default(UNREVIEWED)
  accountantComment           String?               @db.Text
  clientAcknowledgedDelayRisk Boolean               @default(false)
  clientAcknowledgedAt        DateTime?
  clientAcknowledgementText   String?               @db.Text
  uploadedByName              String?
  uploaderComment             String?               @db.Text
  deletedAt                   DateTime?
  deletedByUserId             String?
  deleteReason                String?               @db.Text
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  tvaAmountEntries            TvaAmountEntry[]
  securityScan                DocumentSecurityScan?

  @@index([firmId])
  @@index([clientCollectionId])
  @@index([firmId, deletedAt])
}

model DocumentSecurityScan {
  id              String                     @id @default(cuid())
  firmId          String
  firm            Firm                       @relation(fields: [firmId], references: [id], onDelete: Cascade)
  documentId      String                     @unique
  document        UploadedDocument           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status          DocumentSecurityScanStatus @default(PENDING)
  scannerProvider ScannerProvider            @default(NONE)
  scannerVersion  String?
  details         String?                    @db.Text
  scannedAt       DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([firmId])
  @@index([firmId, status])
}

model TvaReadinessCheck {
  id                       String             @id @default(cuid())
  firmId                   String
  firm                     Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  clientCollectionId       String
  clientCollection         ClientCollection   @relation(fields: [clientCollectionId], references: [id], onDelete: Cascade)
  status                   TvaReadinessStatus
  missingDocumentsCount    Int                @default(0)
  unreviewedDocumentsCount Int                @default(0)
  rejectedDocumentsCount   Int                @default(0)
  unresolvedQuestionsCount Int                @default(0)
  pendingDeclarationsCount Int                @default(0)
  riskLevel                FiscalSeverity     @default(LOW)
  generatedAt              DateTime           @default(now())

  @@index([firmId, generatedAt])
  @@index([clientCollectionId])
  @@index([firmId, status])
}

model TvaAmountEntry {
  id                     String             @id @default(cuid())
  firmId                 String
  firm                   Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  clientId               String
  client                 Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientCollectionId     String
  clientCollection       ClientCollection   @relation(fields: [clientCollectionId], references: [id], onDelete: Cascade)
  uploadedDocumentId     String?
  uploadedDocument       UploadedDocument?  @relation(fields: [uploadedDocumentId], references: [id], onDelete: SetNull)
  type                   TvaAmountEntryType
  invoiceNumber          String?
  invoiceDate            DateTime?
  supplierOrCustomerName String?
  amountHT               Decimal            @db.Decimal(12, 2)
  amountTVA              Decimal            @db.Decimal(12, 2)
  amountTTC              Decimal            @db.Decimal(12, 2)
  tvaRate                Decimal            @db.Decimal(5, 2)
  notes                  String?            @db.Text
  createdByUserId        String
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([firmId])
  @@index([clientId])
  @@index([clientCollectionId])
  @@index([uploadedDocumentId])
  @@index([firmId, type])
}

model ReminderLog {
  id                 String           @id @default(cuid())
  firmId             String
  firm               Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  clientCollectionId String
  clientCollection   ClientCollection @relation(fields: [clientCollectionId], references: [id], onDelete: Cascade)
  channel            ReminderChannel
  message            String           @db.Text
  createdAt          DateTime         @default(now())

  @@index([firmId])
}

model Lead {
  id                 String    @id @default(cuid())
  firmId             String?
  firm               Firm?     @relation(fields: [firmId], references: [id], onDelete: SetNull)
  name               String
  firmName           String
  phone              String
  email              String
  city               String?
  numberOfClients    Int?
  numberOfAssistants Int?
  currentWorkflow    String?
  painLevel          String?
  leadSource         String?
  stage              String    @default("NEW")
  nextFollowUpAt     DateTime?
  assignedOwner      String?
  expectedPlan       String?
  expectedSetupFee   Int?
  preferredDemoAt    DateTime?
  biggestProblem     String?   @db.Text
  message            String?   @db.Text
  notes              String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // AI sourcing (Google Places import) — googlePlaceId is the dedup key so the
  // daily sourcing job never creates the same cabinet twice.
  googlePlaceId String? @unique
  address       String?
  website       String?

  // AI outreach pipeline. A first-contact message is always drafted, never
  // auto-sent (WhatsApp policy requires a human-approved send for the first
  // message to someone who hasn't messaged us — see LeadMessage below for
  // the full conversation log this status is derived from).
  draftMessage String?           @db.Text
  draftStatus  LeadDraftStatus   @default(NONE)
  needsHumanReview Boolean       @default(false)
  aiSummary    String?           @db.Text

  // Tracks WhatsApp's 24-hour free-form messaging window: once lastInboundAt
  // is set, conversationWindowOpenUntil = lastInboundAt + 24h. The AI may only
  // send free-form replies while that window is open.
  lastContactedAt             DateTime?
  lastInboundAt                DateTime?
  conversationWindowOpenUntil DateTime?

  messages LeadMessage[]

  @@index([stage])
  @@index([nextFollowUpAt])
  @@index([draftStatus])
}

enum LeadDraftStatus {
  NONE
  PENDING_APPROVAL
  APPROVED
  SENT
  REJECTED
}

model LeadMessage {
  id        String               @id @default(cuid())
  leadId    String
  lead      Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direction LeadMessageDirection
  channel   String               @default("WHATSAPP")
  body      String               @db.Text
  status    LeadMessageStatus    @default(DRAFT)
  aiIntent  String?
  createdAt DateTime             @default(now())
  sentAt    DateTime?

  @@index([leadId])
  @@index([createdAt])
}

enum LeadMessageDirection {
  OUTBOUND
  INBOUND
}

enum LeadMessageStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  DELIVERED
  FAILED
}

model OperationalEvent {
  id                 String               @id @default(cuid())
  firmId             String
  actorUserId        String?
  actorType          OperationalActorType
  clientId           String?
  collectionId       String?
  clientCollectionId String?
  obligationId       String?
  documentId         String?
  eventType          String
  eventTitle         String
  eventDescription   String?              @db.Text
  metadata           Json?
  occurredAt         DateTime             @default(now())
  ipAddress          String?
  userAgent          String?              @db.Text
  source             String

  @@index([firmId, occurredAt])
  @@index([clientId])
  @@index([collectionId])
  @@index([clientCollectionId])
  @@index([documentId])
  @@index([eventType])
}

model ErrorLog {
  id        String        @id @default(cuid())
  firmId    String?
  firm      Firm?         @relation(fields: [firmId], references: [id], onDelete: SetNull)
  userId    String?
  requestId String        @unique
  route     String?
  method    String?
  message   String        @db.Text
  stack     String?       @db.Text
  severity  ErrorSeverity @default(ERROR)
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([firmId])
  @@index([createdAt])
  @@index([severity])
}

model ReleaseChecklistItem {
  id              String                 @id @default(cuid())
  key             String                 @unique
  status          ReleaseChecklistStatus @default(TODO)
  notes           String?                @db.Text
  checkedByUserId String?
  checkedByUser   User?                  @relation(fields: [checkedByUserId], references: [id], onDelete: SetNull)
  checkedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status])
  @@index([checkedByUserId])
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  key       String   @unique
  attempts  Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model TvaFilingCase {
  id                  String          @id @default(cuid())
  firmId              String
  clientId            String
  clientCollectionId  String          @unique
  periodMonth         Int
  periodYear          Int
  status              TvaFilingStatus @default(DRAFT)
  declarationDeadline DateTime
  paymentDeadline     DateTime
  assignedUserId      String?
  preparedByUserId    String?
  filedByUserId       String?
  filedAt             DateTime?
  archivedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([firmId, status])
  @@index([clientId])
  @@index([clientCollectionId])
  @@index([declarationDeadline])
  @@index([paymentDeadline])
}

model TvaSubmission {
  id                        String              @id @default(cuid())
  firmId                    String
  filingCaseId              String
  status                    TvaSubmissionStatus @default(NOT_SUBMITTED)
  externalReference         String?
  submittedAt               DateTime?
  submittedByUserId         String?
  submissionProofDocumentId String?
  rejectionReason           String?             @db.Text
  notes                     String?             @db.Text
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  @@index([firmId, status])
  @@index([filingCaseId])
}

model TvaPayment {
  id                     String            @id @default(cuid())
  firmId                 String
  filingCaseId           String            @unique
  status                 TvaPaymentStatus  @default(PENDING)
  amountDue              Decimal?          @db.Decimal(12, 2)
  amountPaid             Decimal?          @db.Decimal(12, 2)
  paymentDate            DateTime?
  paymentMethod          TvaPaymentMethod?
  paymentReference       String?
  paymentProofDocumentId String?
  notes                  String?           @db.Text
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([firmId, status])
  @@index([filingCaseId])
}

model FiscalReceipt {
  id                 String            @id @default(cuid())
  firmId             String
  filingCaseId       String
  type               FiscalReceiptType
  uploadedDocumentId String?
  referenceNumber    String?
  receiptDate        DateTime?
  uploadedByUserId   String?
  notes              String?           @db.Text
  createdAt          DateTime          @default(now())

  @@index([firmId, type])
  @@index([filingCaseId])
}

model FiscalAuditCase {
  id                  String                @id @default(cuid())
  firmId              String
  clientId            String
  relatedFilingCaseId String?
  title               String
  type                FiscalAuditCaseType
  status              FiscalAuditCaseStatus @default(OPEN)
  severity            FiscalSeverity        @default(MEDIUM)
  openedByUserId      String
  assignedUserId      String?
  openedAt            DateTime              @default(now())
  closedAt            DateTime?
  summary             String?               @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([firmId, status])
  @@index([firmId, severity])
  @@index([clientId])
  @@index([relatedFilingCaseId])
}

model TaxAuthorityNotice {
  id                 String                   @id @default(cuid())
  firmId             String
  clientId           String?
  filingCaseId       String?
  auditCaseId        String?
  type               TaxAuthorityNoticeType
  receivedAt         DateTime                 @default(now())
  responseDeadline   DateTime?
  referenceNumber    String?
  uploadedDocumentId String?
  summary            String?                  @db.Text
  status             TaxAuthorityNoticeStatus @default(NEW)
  createdByUserId    String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([firmId, status])
  @@index([clientId])
  @@index([filingCaseId])
  @@index([auditCaseId])
  @@index([responseDeadline])
}

model FiscalEvidenceRequest {
  id                  String                      @id @default(cuid())
  firmId              String
  auditCaseId         String
  title               String
  description         String?                     @db.Text
  requestedBy         String
  dueDate             DateTime?
  status              FiscalEvidenceRequestStatus @default(TODO)
  assignedUserId      String?
  evidenceDocumentIds Json?
  responseText        String?                     @db.Text
  submittedAt         DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@index([firmId, status])
  @@index([auditCaseId])
  @@index([dueDate])
}

model AuditResponseDraft {
  id                  String              @id @default(cuid())
  firmId              String
  auditCaseId         String
  title               String
  responseBody        String              @db.Text
  attachedEvidenceIds Json?
  status              AuditResponseStatus @default(DRAFT)
  createdByUserId     String
  approvedByUserId    String?
  sentAt              DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([firmId, status])
  @@index([auditCaseId])
}

model SubscriptionPlan {
  id                    String             @id @default(cuid())
  code                  String             @unique
  name                  String
  monthlyPriceMad       Int
  monthlyPriceUsd       Int?
  yearlyPriceUsd        Int?
  clientLimit           Int?
  userLimit             Int?
  storageLimitMb        Int?
  activeCollectionLimit Int?
  hasZipExport          Boolean            @default(false)
  hasAdvancedReports    Boolean            @default(false)
  hasWhiteLabel         Boolean            @default(false)
  hasWorkflowBuilder    Boolean            @default(false)
  lemonMonthlyVariantId String?
  lemonYearlyVariantId  String?
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  subscriptions         FirmSubscription[]
}

model FirmSubscription {
  id                      String             @id @default(cuid())
  firmId                  String
  firm                    Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  planId                  String
  plan                    SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  provider                String             @default("LEMON_SQUEEZY")
  lemonCustomerId         String?
  lemonOrderId            String?
  lemonSubscriptionId     String?            @unique
  lemonProductId          String?
  lemonVariantId          String?
  lemonSubscriptionItemId String?
  lemonStatus             String?
  status                  SubscriptionStatus
  startedAt               DateTime
  trialEndsAt             DateTime?
  currentPeriodStart      DateTime
  currentPeriodEnd        DateTime
  renewsAt                DateTime?
  endsAt                  DateTime?
  cardBrand               String?
  cardLastFour            String?
  customerPortalUrl       String?
  updatePaymentMethodUrl  String?
  cancelledAt             DateTime?
  suspendedAt             DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  invoices                BillingInvoice[]

  @@unique([firmId])
  @@index([firmId])
  @@index([firmId, status])
  @@index([planId])
  @@index([lemonVariantId])
}

model BillingEvent {
  id              String    @id @default(cuid())
  provider        String    @default("LEMON_SQUEEZY")
  eventName       String
  externalEventId String?   @unique
  firmId          String?
  subscriptionId  String?
  payload         Json
  processedAt     DateTime?
  processingError String?   @db.Text
  createdAt       DateTime  @default(now())

  @@index([firmId])
  @@index([subscriptionId])
  @@index([eventName])
  @@index([createdAt])
}

model BillingInvoice {
  id              String                @id @default(cuid())
  firmId          String
  firm            Firm                  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  subscription    FirmSubscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoiceNumber   String                @unique
  status          InvoiceStatus
  amountMad       Int
  dueDate         DateTime
  paidAt          DateTime?
  paymentMethod   BillingPaymentMethod?
  notes           String?               @db.Text
  createdByUserId String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  paymentProofs   PaymentProof[]
  receipt         BillingReceipt?

  @@index([firmId, status])
  @@index([firmId, dueDate])
  @@index([subscriptionId])
}

model PaymentProof {
  id                String               @id @default(cuid())
  firmId            String
  firm              Firm                 @relation(fields: [firmId], references: [id], onDelete: Cascade)
  invoiceId         String
  invoice           BillingInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  originalFileName  String?
  storageKey        String?
  mimeType          String?
  size              Int?
  amountMad         Int?
  method            BillingPaymentMethod
  reference         String?
  status            PaymentProofStatus   @default(SUBMITTED)
  submittedByUserId String
  reviewedByUserId  String?
  reviewedAt        DateTime?
  adminComment      String?              @db.Text
  createdAt         DateTime             @default(now())

  @@index([firmId])
  @@index([invoiceId])
  @@index([firmId, status])
}

model BillingReceipt {
  id            String               @id @default(cuid())
  firmId        String
  firm          Firm                 @relation(fields: [firmId], references: [id], onDelete: Cascade)
  invoiceId     String               @unique
  invoice       BillingInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receiptNumber String               @unique
  amountMad     Int
  paymentMethod BillingPaymentMethod
  paidAt        DateTime
  reference     String?
  createdAt     DateTime             @default(now())

  @@index([firmId])
}

model PlatformBillingSettings {
  id                  String   @id @default("default")
  bankName            String?
  accountHolder       String?
  rib                 String?
  iban                String?
  paymentInstructions String?  @db.Text
  supportEmail        String?
  supportWhatsapp     String?
  updatedAt           DateTime @updatedAt
}
