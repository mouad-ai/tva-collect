generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CollectionStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ClientCollectionStatus {
  NOT_STARTED
  IN_PROGRESS
  MISSING
  COMPLETE
}

enum RequiredDocumentStatus {
  MISSING
  RECEIVED
  NOT_APPLICABLE
}

enum ReminderChannel {
  WHATSAPP
  EMAIL
  PHONE
  MANUAL
}

enum DocumentQualityStatus {
  UNREVIEWED
  VALID
  WRONG_DOCUMENT
  UNREADABLE
  DUPLICATE
  MISSING_PAGE
  NOT_TVA
}

enum OperationalActorType {
  USER
  CLIENT
  SYSTEM
}

enum WorkflowType {
  TVA_MONTHLY
  TVA_QUARTERLY
  CNSS_MONTHLY
  PAYROLL
  ANNUAL_CLOSING
  BANK_DOCUMENTS
  LEGAL_DOCUMENTS
  CLIENT_ONBOARDING
  EMPLOYEE_DOCUMENTS
  SUPPLIER_DOCUMENTS
  CUSTOM
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  firmId       String
  firm         Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Firm {
  id                      String             @id @default(cuid())
  name                    String
  city                    String?
  phone                   String?
  email                   String?
  logoUrl                 String?
  defaultRequiredDocuments Json?
  reminderTemplate         String?            @db.Text
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  users                   User[]
  clients                 Client[]
  collectionPeriods       CollectionPeriod[]
  clientCollections       ClientCollection[]
  requiredDocuments       RequiredDocument[]
  uploadedDocuments       UploadedDocument[]
  reminderLogs            ReminderLog[]
  leads                   Lead[]
}

model Client {
  id                String             @id @default(cuid())
  firmId            String
  firm              Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  companyName       String
  contactName       String?
  email             String?
  phone             String?
  ice               String?
  taxId             String?
  city              String?
  notes             String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  clientCollections ClientCollection[]

  @@index([firmId])
}

model CollectionPeriod {
  id                String             @id @default(cuid())
  firmId            String
  firm              Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  name              String
  workflowType      WorkflowType        @default(TVA_MONTHLY)
  month             Int
  year              Int
  status            CollectionStatus   @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  clientCollections ClientCollection[]

  @@index([firmId])
  @@index([firmId, workflowType])
}

model ClientCollection {
  id                 String                 @id @default(cuid())
  firmId             String
  firm               Firm                   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  clientId           String
  client             Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  collectionPeriodId String
  collectionPeriod   CollectionPeriod       @relation(fields: [collectionPeriodId], references: [id], onDelete: Cascade)
  uploadToken        String                 @unique
  status             ClientCollectionStatus @default(NOT_STARTED)
  accountantNotes    String?                @db.Text
  completionConfirmedAt DateTime?
  completionConfirmationText String?         @db.Text
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  requiredDocuments  RequiredDocument[]
  uploadedDocuments  UploadedDocument[]
  reminderLogs       ReminderLog[]

  @@unique([clientId, collectionPeriodId])
  @@index([firmId])
}

model RequiredDocument {
  id                 String                 @id @default(cuid())
  firmId             String
  firm               Firm                   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  clientCollectionId String
  clientCollection   ClientCollection       @relation(fields: [clientCollectionId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  isRequired         Boolean                @default(true)
  status             RequiredDocumentStatus @default(MISSING)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  uploadedDocuments  UploadedDocument[]

  @@index([firmId])
  @@index([clientCollectionId])
}

model UploadedDocument {
  id                 String            @id @default(cuid())
  firmId             String
  firm               Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  clientCollectionId String
  clientCollection   ClientCollection  @relation(fields: [clientCollectionId], references: [id], onDelete: Cascade)
  requiredDocumentId String?
  requiredDocument   RequiredDocument? @relation(fields: [requiredDocumentId], references: [id], onDelete: SetNull)
  originalFileName   String
  storageKey         String
  mimeType           String
  size               Int
  qualityStatus      DocumentQualityStatus @default(UNREVIEWED)
  accountantComment  String?           @db.Text
  clientAcknowledgedDelayRisk Boolean   @default(false)
  clientAcknowledgedAt DateTime?
  clientAcknowledgementText String?     @db.Text
  uploadedByName     String?
  uploaderComment    String?           @db.Text
  createdAt          DateTime          @default(now())

  @@index([firmId])
  @@index([clientCollectionId])
}

model ReminderLog {
  id                 String            @id @default(cuid())
  firmId             String
  firm               Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  clientCollectionId String
  clientCollection   ClientCollection  @relation(fields: [clientCollectionId], references: [id], onDelete: Cascade)
  channel            ReminderChannel
  message            String            @db.Text
  createdAt          DateTime          @default(now())

  @@index([firmId])
}

model Lead {
  id                String   @id @default(cuid())
  firmId            String?
  firm              Firm?    @relation(fields: [firmId], references: [id], onDelete: SetNull)
  name              String
  firmName          String
  phone             String
  email             String
  city              String?
  numberOfClients   Int?
  numberOfAssistants Int?
  currentWorkflow   String?
  painLevel         String?
  leadSource        String?
  stage             String   @default("NEW")
  nextFollowUpAt    DateTime?
  assignedOwner     String?
  expectedPlan      String?
  expectedSetupFee  Int?
  preferredDemoAt   DateTime?
  biggestProblem    String?  @db.Text
  message           String?  @db.Text
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([stage])
  @@index([nextFollowUpAt])
}

model OperationalEvent {
  id               String               @id @default(cuid())
  firmId           String
  actorUserId      String?
  actorType        OperationalActorType
  clientId         String?
  collectionId     String?
  clientCollectionId String?
  obligationId     String?
  documentId       String?
  eventType        String
  eventTitle       String
  eventDescription String?              @db.Text
  metadata         Json?
  occurredAt       DateTime             @default(now())
  ipAddress        String?
  userAgent        String?              @db.Text
  source           String

  @@index([firmId, occurredAt])
  @@index([clientId])
  @@index([collectionId])
  @@index([clientCollectionId])
  @@index([documentId])
  @@index([eventType])
}
