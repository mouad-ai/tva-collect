DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tvacollect"
NODE_ENV="development"
AUTH_SECRET="change-me-long-random-secret"
NEXTAUTH_SECRET="change-me-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
# Zone base URLs. In production these are distinct subdomains; locally they all
# resolve to the same dev origin so cross-domain redirects are skipped.
APP_URL="http://localhost:3000"
# Public marketing domain. Client upload/share links (/upload/[token]) are built
# from PUBLIC_SITE_URL (falls back to PUBLIC_URL) because that page is public.
PUBLIC_SITE_URL="http://localhost:3000"
PUBLIC_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3000"
# Optional: force the session cookie Domain (e.g. ".tvacollect.com") so a single
# login is shared across app/admin/www. Auto-derived from PUBLIC_HOST when unset;
# leave empty for localhost (host-only cookie).
SESSION_COOKIE_DOMAIN=""
UPLOAD_STORAGE="local"
LOCAL_UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="10"
SESSION_MAX_AGE_SECONDS="2592000"
SESSION_IDLE_TIMEOUT_SECONDS="28800"
UPLOAD_TOKEN_TTL_DAYS="90"
EMAIL_PROVIDER="console"
EMAIL_FROM="TVA Collect <no-reply@tvacollect.com>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_HELO_HOST="tvacollect.local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"
ADMIN_EMAIL=""
ADMIN_NAME=""
# Public support address shown in-app (footer, login, client upload page, help).
SUPPORT_EMAIL="contact@tvacollect.com"
# Where new /contact and /demo leads are emailed. Falls back to ADMIN_EMAIL,
# then SUPPORT_EMAIL, if unset.
LEAD_NOTIFICATION_EMAIL=""
# Backup script settings (scripts/backup.sh). See docs/backup-restore.md.
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="14"
# Optional rclone remote (e.g. "b2:tvacollect-backups") for off-site backup copy.
BACKUP_REMOTE=""
# Optional: a Slack/Discord/Mattermost incoming webhook URL. When set, every
# ERROR/CRITICAL server error (including a missing rate-limit table) posts a
# one-line alert here. This is the entire "monitoring" story until a real
# APM (Sentry etc.) is wired in — leave empty to disable.
ALERT_WEBHOOK_URL=""
# Optional: real antivirus scanning for uploaded files via a clamd daemon.
# Leave unset to fall back to extension/MIME/content-signature checks only
# (no real malware scan) — see lib/file-security.ts.
CLAMAV_HOST=""
CLAMAV_PORT="3310"
