{
  "name": "tva-collect",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test tests/*.ts && node tests/security.test.mjs",
    "smoke:functional": "tsx scripts/functional-smoke.ts",
    "production:check": "tsx scripts/production-check.ts",
    "release:check": "prisma validate && npm run lint && npm run build",
    "postinstall": "prisma generate",
    "seed": "prisma db seed",
    "create-admin": "tsx scripts/create-admin.ts",
    "diagnose-auth": "tsx scripts/diagnose-auth.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@prisma/client": "5.22.0",
    "@trigger.dev/sdk": "4.5.9",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "16.2.9",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^6.16.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.2",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-config-next": "16.2.9",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  },
  "prisma": {
    "seed": "node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  }
}
