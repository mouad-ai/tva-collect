NODE_ENV=production

POSTGRES_USER=tvacollect
POSTGRES_PASSWORD=change-this-long-postgres-password
POSTGRES_DB=tvacollect
DATABASE_URL=postgresql://tvacollect:change-this-long-postgres-password@postgres:5432/tvacollect

AUTH_SECRET=change-this-very-long-random-secret
NEXTAUTH_SECRET=change-this-very-long-random-secret
APP_URL=https://app.tvacollect.com
ADMIN_URL=https://admin.tvacollect.com
PUBLIC_URL=https://tvacollect.com
# Public base used to build client upload/share links (/upload/[token]).
# Falls back to PUBLIC_URL when unset. Keep it on the public marketing domain.
PUBLIC_SITE_URL=https://tvacollect.com
APP_HOST=app.tvacollect.com
ADMIN_HOST=admin.tvacollect.com
PUBLIC_HOST=tvacollect.com
NEXTAUTH_URL=https://app.tvacollect.com
# Shared session cookie domain so login happens ONCE across app/admin/www.
# Must start with a dot. Auto-derived from PUBLIC_HOST if omitted.
SESSION_COOKIE_DOMAIN=.tvacollect.com

SESSION_MAX_AGE_SECONDS=2592000
SESSION_IDLE_TIMEOUT_SECONDS=28800
UPLOAD_TOKEN_TTL_DAYS=90
MAX_UPLOAD_SIZE_MB=10

UPLOAD_STORAGE=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=tvacollect-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=tvacollect-app
S3_SECRET_KEY=change-this-long-app-s3-password

MINIO_ROOT_USER=tvacollect-minio-admin
MINIO_ROOT_PASSWORD=change-this-long-minio-password

EMAIL_PROVIDER=resend
EMAIL_FROM="TVA Collect <no-reply@tvacollect.com>"
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Alternative if you do not use Resend:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@tvacollect.com
# SMTP_PASSWORD=change-this-smtp-password
# SMTP_FROM=no-reply@tvacollect.com
# SMTP_HELO_HOST=tvacollect.com

BILLING_PROVIDER=LEMON_SQUEEZY
LEMONSQUEEZY_API_KEY=change-this-lemon-api-key
LEMONSQUEEZY_STORE_ID=change-this-lemon-store-id
LEMONSQUEEZY_WEBHOOK_SECRET=change-this-long-lemon-webhook-secret
LEMONSQUEEZY_STARTER_MONTHLY_VARIANT_ID=change-this-starter-monthly-variant
LEMONSQUEEZY_STARTER_YEARLY_VARIANT_ID=change-this-starter-yearly-variant
LEMONSQUEEZY_PRO_MONTHLY_VARIANT_ID=change-this-pro-monthly-variant
LEMONSQUEEZY_PRO_YEARLY_VARIANT_ID=change-this-pro-yearly-variant
LEMONSQUEEZY_PREMIUM_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_PREMIUM_YEARLY_VARIANT_ID=

ADMIN_EMAIL=admin@example.com
ADMIN_NAME=TVA Collect Admin
CERTBOT_EMAIL=admin@example.com

# Public support address shown in-app (footer, login, client upload page, help).
SUPPORT_EMAIL=contact@tvacollect.com
# Where new /contact and /demo leads are emailed. Falls back to ADMIN_EMAIL,
# then SUPPORT_EMAIL, if unset. Set this to whoever should respond to leads.
LEAD_NOTIFICATION_EMAIL=contact@tvacollect.com

# scripts/backup.sh settings — see docs/backup-restore.md
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Optional rclone remote (e.g. "b2:tvacollect-backups") for off-site backup copy.
BACKUP_REMOTE=
